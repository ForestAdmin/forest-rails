# Rails 8.0 leg of the CI matrix. Locally:
#   export BUNDLE_GEMFILE=$PWD/gemfiles/rails_8.0.gemfile
#   bundle install && RAILS_ENV=test bundle exec rake test db:migrate && bundle exec rspec
source 'https://rubygems.org'

eval_gemfile File.expand_path('common.gemfile', __dir__)

gem 'rails', '~> 8.0.5'

group :test do
  gem 'sqlite3', '>= 2.1'
  # 12.x supports Rails 7.1 through 8.0 (activerecord requirement); 13.x is 8.1-only.
  gem 'acts-as-taggable-on', '~> 12.0'
end
